# Copia este archivo a .streamlit/secrets.toml y llena tus credenciales reales.
# NO subas el archivo real con credenciales a GitHub.

[supabase]
url = "https://TU-PROYECTO.supabase.co"
key = "TU-SUPABASE-ANON-O-SERVICE-KEY"

[google_chat]
# Espacio de Chat > Apps y integraciones > Webhooks > Crear webhook
webhook_url = "https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=XXXX&token=XXXX"

[gmail]
usuario = "notificaciones@imemsa.com"
password = "contraseña-de-aplicacion-de-16-digitos"

# Pega aquí, TAL CUAL, cada campo del archivo JSON que descargas al crear
# la cuenta de servicio en Google Cloud Console (Paso 6 de la guía).
[google_service_account]
type = "service_account"
project_id = "tu-proyecto-id"
private_key_id = "xxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nXXXXXXXX\n-----END PRIVATE KEY-----\n"
client_email = "tareas-pm-sync@tu-proyecto-id.iam.gserviceaccount.com"
client_id = "xxxxxxxxxxxxxxxxxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/tareas-pm-sync%40tu-proyecto-id.iam.gserviceaccount.com"
